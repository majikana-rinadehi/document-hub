{
  "name": "document-hub",
  "version": "1.0.0",
  "description": "Notion記事をMarkdownに変換して管理するドキュメントハブ",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test",
    "fetch": "bun run src/cli.ts",
    "lint:es": "eslint src",
    "lint:es:fix": "eslint src --fix",
    "lint:ox": "oxlint",
    "lint:ox:fix": "oxlint --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@notionhq/client": "^2.2.14",
    "notion-to-md": "^3.1.1",
    "zenn-cli": "^0.2.3"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.4",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.14.0",
    "@types/bun": "latest",
    "@types/eslint__js": "^9.14.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.15.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^17.1.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.0",
    "oxlint": "^1.47.0",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3"
  },
  "author": "",
  "license": "MIT"
}